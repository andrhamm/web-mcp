{
  "name": "@andrhamm/web-mcp",
  "version": "0.2.0",
  "description": "Local MCP server that answers web research questions with compact, cited, goal-filtered results sized to a token cap",
  "type": "module",
  "license": "MIT",
  "author": "Andrew Hammond",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrhamm/web-mcp.git"
  },
  "homepage": "https://github.com/andrhamm/web-mcp#readme",
  "bugs": {
    "url": "https://github.com/andrhamm/web-mcp/issues"
  },
  "bin": {
    "web-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "prompts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "web-search",
    "research",
    "rag",
    "claude",
    "brave"
  ],
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@mozilla/readability": "^0.6.0",
    "gpt-tokenizer": "^4.1.0",
    "linkedom": "^0.18.14",
    "minisearch": "^7.2.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
